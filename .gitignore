config/local.toml

# The pnpm workspace (frontend/, packages/).
node_modules/

# What the frontend build leaves.
.output/
.nitro/
.tanstack/

# What `pnpm check` leaves: each package's coverage, which `fallow health`
# reads, and fallow's cache.
coverage/
.fallow/

.claude/worktrees/

# The deploy wizard's answers (`frontend/scripts/deploy-wizard.sh`).
.env.deploy

# Read-only source checkouts agents read (AGENTS.md "Código do Effect").
.repos/

# What the e2e leaves (`frontend/playwright.config.ts`).
test-results/
playwright-report/

# What Storybook leaves: its build (`pnpm build-storybook`) and the
# screenshots of a failing story (`pnpm test:stories`).
storybook-static/
.vitest/
