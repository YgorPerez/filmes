{
  "name": "filmes",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "start": "pnpm --filter frontend start",
    "catalog:update": "node frontend/scripts/catalog-update.ts",
    "db:publish": "node frontend/scripts/db-publish.ts",
    "check": "vp check && node frontend/lint/folders.ts && vp run -r --cache test:coverage && vp test run --coverage && vp run --filter frontend --filter @filmes/engine fallow && vp run --filter frontend doctor",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "test": "vp test run && vp run -r --cache test",
    "typecheck": "vp run -r --cache typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@shadcn/lint": "0.2.5",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.10.1"
}
