  "exitCode": 1,
  "output": {
    "error": {
      "code": "invalid_data",
      "message": "<root>/catalogo/ml-32m: invalid literal for int() with base 10: '1.5'",
    },
  },
}
`;

exports[`avaliar on MovieLens files, as recorded > only links.csv is refused 1`] = `
{
  "exitCode": 1,
  "output": {
    "error": {
      "code": "invalid_data",
      "message": "<root>/catalogo/ml-32m: são necessários ratings.csv e links.csv para avaliar o MovieLens",
    },
  },
}
`;

